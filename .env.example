# MtaaFix backend - copy to .env and fill in. Never commit .env.
# PRODUCTION (Spring profile "prod"): the app REFUSES to start with any of
# the shipped default values below (ProdSecretsGuard, Phase 16) - replace
# SPRING_DATASOURCE_PASSWORD, JWT_SECRET, and GEO_FUZZ_SECRET with real
# random values (jwt/geo secrets must be >= 32 chars) before deploying.

# Server
SERVER_PORT=8080

# PostgreSQL (+ PostGIS extension required in the target database)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mtaafix?currentSchema=public&ssl=false
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Flyway
SPRING_FLYWAY_ENABLED=true

# JWT - use a long random secret in any non-local environment (min 32 chars)
JWT_SECRET=min-32-char-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Rate limiting (Phase 16): per-IP fixed one-minute windows.
# Applied to POST /api/v1/auth/** (login, register, forgot, ...) and
# POST /api/v1/reports. Under the prod profile (Phase 18) forwarded
# headers are honoured, so buckets key on the real client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_REPORT_PER_MINUTE=20

# Phase 17: WARN log threshold for slow requests (ms)
TIMING_WARN_THRESHOLD_MS=500

# Phase 19 (observability + backups):
# - Metrics: GET /actuator/prometheus is exposed on the app port WITHOUT
#   authentication (owner decision 2026-10-23). Exposed endpoints are
#   health,prometheus only; keep the app port on loopback/private network
#   and allowlist the path at the proxy (docs/operations/DEPLOYMENT.md §5).
#   No variable to set - the exposure list lives in application*.yml.
# - The `prod` profile logs structured JSON (one event per line, requestId
#   as a JSON key); the pattern above stays for local/dev consoles.
# - backup.ps1 / restore-database.ps1 read the DB password from the
#   invoking shell's environment (never hardcode it):
PGPASSWORD=change-me

# Public location generalization (FR-11.4): deterministic HMAC offset.
# ProdSecretsGuard requires >= 32 chars in the prod profile.
GEO_FUZZ_SECRET=mtaafix-local-dev-geo-fuzz-secret

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Media upload cap (bytes) - default 20 MiB
MEDIA_MAX_FILE_SIZE_BYTES=20971520

# Media per-report attachment cap (default 10)
MEDIA_MAX_PER_REPORT=10

# Notifications (Phase 13): email channel is OFF until an SMTP provider exists.
# Deliveries are recorded as SKIPPED while disabled (FR-6.3).
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_FROM=no-reply@mtaafix.local
NOTIFICATIONS_EMAIL_STARTTLS=true
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Web links used in outgoing emails (reset links, report deep links)
NOTIFICATIONS_WEB_BASE_URL=http://localhost:5173
# Push (FCM/APNs) has no provider configured; keep disabled
NOTIFICATIONS_PUSH_ENABLED=false

# Logging
LOGGING_LEVEL_COM_MTAAFIX=INFO
